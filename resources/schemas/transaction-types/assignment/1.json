{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://ituoiprofessionistidigitali.it/contract/transaction-types/assignment/1.json",
    "title": "assignment v1",
    "description": "Il lavoro affidato: un processo e le sue attività, con i nomi del catalogo dello studio. Nessun testo libero e nessun dato del cliente finale: nome, codice fiscale e partita IVA del cliente non hanno un campo e non sono ammessi.",
    "type": "object",
    "properties": {
        "process": {
            "type": "object",
            "properties": {
                "name": { "type": "string", "minLength": 1, "maxLength": 255 }
            },
            "required": ["name"],
            "additionalProperties": false
        },
        "activities": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
                "type": "object",
                "properties": {
                    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
                    "deadline": { "type": ["string", "null"], "format": "date" },
                    "estimated_minutes": { "type": ["integer", "null"], "minimum": 0 }
                },
                "required": ["name"],
                "additionalProperties": false
            }
        }
    },
    "required": ["process", "activities"],
    "additionalProperties": false
}
