{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://ituoiprofessionistidigitali.it/contract/event-types/transaction.application_withdrawn/1.json",
    "title": "transaction.application_withdrawn v1",
    "description": "Una candidatura ritirata dal professionista, o perché il suo account è stato cancellato o disattivato. La manda solo il portale, al sistema del committente.",
    "type": "object",
    "properties": {
        "transaction": {
            "description": "La transazione dell'incarico pubblicato.",
            "type": "object",
            "properties": {
                "id": {
                    "$ref": "#/$defs/uuid"
                },
                "reference": {
                    "$ref": "#/$defs/reference"
                }
            },
            "required": [
                "id",
                "reference"
            ],
            "additionalProperties": false
        },
        "application": {
            "type": "object",
            "properties": {
                "id": {
                    "$ref": "#/$defs/uuid"
                },
                "status": {
                    "const": "withdrawn"
                },
                "applied_at": {
                    "$ref": "#/$defs/datetime"
                },
                "terms_accepted_at": {
                    "description": "Il consenso del professionista alle condizioni dell'incarico.",
                    "$ref": "#/$defs/datetime"
                },
                "accepted_revision": {
                    "description": "La revisione della transazione di cui il professionista ha accettato le condizioni.",
                    "type": "integer",
                    "minimum": 1
                },
                "closed_at": {
                    "$ref": "#/$defs/datetime"
                },
                "applicant": {
                    "$ref": "#/$defs/applicant"
                }
            },
            "required": [
                "id",
                "status",
                "applied_at",
                "terms_accepted_at",
                "accepted_revision",
                "closed_at",
                "applicant"
            ],
            "additionalProperties": false
        }
    },
    "required": [
        "transaction",
        "application"
    ],
    "additionalProperties": false,
    "$defs": {
        "uuid": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "datetime": {
            "type": "string",
            "format": "date-time"
        },
        "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191
        },
        "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
        },
        "province": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
        },
        "applicant": {
            "description": "Il candidato, senza codice fiscale, email, partita IVA e cellulare, che arrivano solo con la scelta.",
            "type": "object",
            "properties": {
                "type": {
                    "const": "person"
                },
                "first_name": {
                    "$ref": "#/$defs/name"
                },
                "last_name": {
                    "$ref": "#/$defs/name"
                },
                "municipality": {
                    "$ref": "#/$defs/name"
                },
                "province": {
                    "$ref": "#/$defs/province"
                },
                "tax_code_verified": {
                    "description": "Se il codice fiscale è stato verificato; altrimenti è quello dichiarato dal professionista, con il solo controllo formale.",
                    "type": "boolean"
                }
            },
            "required": [
                "type",
                "first_name",
                "last_name",
                "municipality",
                "province",
                "tax_code_verified"
            ],
            "additionalProperties": false
        }
    }
}
