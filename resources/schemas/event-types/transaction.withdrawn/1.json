{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://ituoiprofessionistidigitali.it/contract/event-types/transaction.withdrawn/1.json",
    "title": "transaction.withdrawn v1",
    "description": "Il ritiro di un incarico pubblicato fatto dal portale, scaduto da tempo senza una scelta. La manda solo il portale, al sistema del committente.",
    "type": "object",
    "properties": {
        "transaction": {
            "description": "La transazione ritirata, nella forma di GET /transactions. Il portale può aggiungere campi alla transazione senza cambiare versione.",
            "type": "object",
            "properties": {
                "id": {
                    "$ref": "#/$defs/uuid"
                },
                "origin": {
                    "const": "platform"
                },
                "reference": {
                    "$ref": "#/$defs/reference"
                },
                "assignment_reference": {
                    "$ref": "#/$defs/reference"
                },
                "audience": {
                    "enum": [
                        "person",
                        "member",
                        "any"
                    ]
                },
                "principal": {
                    "$ref": "#/$defs/uuid"
                },
                "counterparty": {
                    "type": "null"
                },
                "typology": {
                    "type": "string",
                    "minLength": 1
                },
                "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                },
                "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                },
                "status": {
                    "const": "withdrawn"
                },
                "sent_at": {
                    "$ref": "#/$defs/datetime"
                },
                "expires_at": {
                    "$ref": "#/$defs/datetime"
                },
                "responded_at": {
                    "type": "null"
                },
                "signed_at": {
                    "type": "null"
                },
                "closed_at": {
                    "description": "L'istante del ritiro.",
                    "$ref": "#/$defs/datetime"
                },
                "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                },
                "total_cents": {
                    "type": "integer",
                    "minimum": 0
                },
                "revision": {
                    "description": "La revisione registrata più 1.",
                    "type": "integer",
                    "minimum": 2
                },
                "type": {
                    "type": "string",
                    "minLength": 1
                },
                "schema_version": {
                    "type": "integer",
                    "minimum": 1
                },
                "activities": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 500,
                    "items": {
                        "type": "object",
                        "properties": {
                            "status": {
                                "const": "open"
                            },
                            "closed_at": {
                                "type": "null"
                            }
                        },
                        "required": [
                            "reference",
                            "compensation",
                            "estimated_minutes",
                            "minutes_worked",
                            "status",
                            "closed_at",
                            "total_cents",
                            "description"
                        ]
                    }
                },
                "updated_at": {
                    "$ref": "#/$defs/datetime"
                }
            },
            "required": [
                "id",
                "origin",
                "reference",
                "assignment_reference",
                "audience",
                "principal",
                "counterparty",
                "typology",
                "title",
                "description",
                "status",
                "sent_at",
                "expires_at",
                "responded_at",
                "signed_at",
                "closed_at",
                "currency",
                "total_cents",
                "revision",
                "type",
                "schema_version",
                "activities",
                "updated_at"
            ]
        },
        "reason": {
            "description": "Perché il portale ha ritirato l'incarico: expired, scaduto da più giorni di quelli che l'operatore ha configurato, senza una scelta.",
            "enum": [
                "expired"
            ]
        }
    },
    "required": [
        "transaction",
        "reason"
    ],
    "additionalProperties": false,
    "$defs": {
        "uuid": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "datetime": {
            "type": "string",
            "format": "date-time"
        },
        "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191
        }
    }
}
